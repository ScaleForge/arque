{
  "$schema": "https://swc.rs/schema.json",
  "exclude": [
    ".*\\.test\\.ts$"
  ],
  "jsc": {
    "parser": {
      "syntax": "typescript",
      "decorators": true
    },
    "target": "es2017",
    "transform": {
      "legacyDecorator": true,
      "decoratorMetadata": true,
      "useDefineForClassFields": false
    }
  },
  "module": {
    "type": "commonjs"
  },
  "sourceMaps": true
}
