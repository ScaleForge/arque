{
  "$schema": "https://opencode.ai/config.json",
  "plugins": ["@tarquinen/opencode-dcp@latest"],
  "instructions": [".opencode/instructions/*.md"],
  "permissions": [
    {
      "action": "external_directory",
      "resource": "~/.cargo/**",
      "effect": "allow"
    }
  ],
  "mcp": {
    "servers": {
      "serena": {
        "type": "local",
        "command": [
          "serena",
          "start-mcp-server",
          "--context",
          "ide",
          "--project-from-cwd",
          "--open-web-dashboard",
          "False"
        ],
        "disabled": false,
        "timeout": {
          "catalog": 60000,
          "execution": 60000
        }
      }
    }
  },
  "formatter": true,
  "lsp": true,
  "agents": {
    "plan": {
      "model": "openai/gpt-6-astra#high"
    },
    "build": {
      "model": "openai/gpt-6-sol"
    },
    "explore": {
      "model": "openai/gpt-6-luna#high"
    }
  }
}
