{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["@tarquinen/opencode-dcp@latest"],
  "instructions": [".opencode/instructions/*.md"],
  "permission": {
    "external_directory": {
      "~/.cargo/**": "allow"
    }
  },
  "mcp": {
    "serena": {
      "type": "local",
      "command": [
        "serena",
        "start-mcp-server",
        "--context",
        "ide",
        "--project-from-cwd",
        "--open-web-dashboard",
        "False",
      ],
      "enabled": true,
      "timeout": 60000,
    }
  },
  "formatter": true,
  "lsp": true,
  "agent": {
    "build": {
      "model": "openai/gpt-5.6-sol",
      "variant": "high"
    },
    "plan": {
      "model": "openai/gpt-5.6-terra",
      "variant": "high",
      "temperature": 1.25
    },
    "explore": {
      "model": "openai/gpt-5.6-luna",
      "variant": "high"
    }
  }
}
